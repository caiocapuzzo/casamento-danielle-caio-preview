{
  "rewrites": [
    { "source": "/admin-tests/:path*", "destination": "/admin-internal-not-found" },
    { "source": "/PAINEL-PRESENCAS.md", "destination": "/admin-internal-not-found" }
  ],
  "headers": [
    {
      "source": "/painel-presencas.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'" }
      ]
    }
  ]
}
